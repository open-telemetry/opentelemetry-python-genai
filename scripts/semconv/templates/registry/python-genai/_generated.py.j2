{% for attr in op.template_attributes %}
{% if common.is_sampling_relevant(op.attributes, attr) %}
        {{ common.attr_field_name(attr, ctx.root_namespace) }} = _span_name_value(self._{{ common.attr_field_name(attr, ctx.root_namespace) }})
{% else %}
        {{ common.attr_field_name(attr, ctx.root_namespace) }} = _span_name_value(self.{{ common.attr_field_name(attr, ctx.root_namespace) }})
{% endif %}
{% endfor %}
{% for t in op.templates %}
{% if t.attributes %}
        if {% for attr in t.attributes %}{{ common.attr_field_name(attr, ctx.root_namespace) }}{% if not loop.last %} and {% endif %}{% endfor %}:
            return f"{{ common.format_template(t, ctx.root_namespace) }}"
{% else %}
