{% endif %}
    def start(
        self,
        name: str | None = None,
        *,
        context: Context | None = None,
        start_time: int | None = None,
    ) -> Span:
        """Start the span for this operation."""
{% if op.templates %}
        if name is None:
            name = self.span_name
{% else %}
        if name is None:
            name = "{{ op.operation_id }}"
{% endif %}
        sampling_attributes: dict[str, AttributeValue] = {}
{% for attribute in op.span.attributes %}
{% if attribute.sampling_relevant %}
        if self._{{ common.field_name(attribute, ctx.root_namespace) }} is not None:
            sampling_attributes[{{ common.constant(attribute, ctx.root_namespace) }}] = _value(
                self._{{ common.field_name(attribute, ctx.root_namespace) }}
            )
{% endif %}
{% endfor %}
        self._monotonic_start_s = timeit.default_timer()
        self._span = self._tracer.start_span(
            name,
            context=context,
            kind=SpanKind.{{ op.span.kind | upper }},
            attributes=sampling_attributes,
            start_time=start_time,
        )
        self._context = set_span_in_context(self._span, context)
        return self._span

    def __enter__(self) -> Self:
        if self._span is not None:
            self._scope = use_span(
                self._span,
                end_on_exit=False,
                record_exception=False,
                set_status_on_exception=False,
            )
            self._scope.__enter__()
        return self

    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_val: BaseException | None,
        exc_tb: TracebackType | None,
    ) -> None:
        try:
            if exc_val is not None:
                self.finish(error=exc_val)
            else:
                self.finish()
        finally:
            if self._scope is not None:
                self._scope.__exit__(None, None, None)
                self._scope = None

    def finish(
        self,
        *,
        error: Error | BaseException | None = None,
        duration_s: float | None = None,
        end_time: int | None = None,
        content_capturing_mode: ContentCapturingMode | None = None,
        emit_event: bool | None = None,
        context: Context | None = None,
    ) -> None:
        """Finish the operation: apply attributes, record metrics, emit event, and end span."""
        if self._ended or self._span is None:
            return
        self._ended = True
        span = self._span
        ctx = context if context is not None else self._context
{% if common.has_content_attributes(op.span.attributes, params.content_attributes) or (op.events and common.has_content_attributes(op.events[0].attributes, params.content_attributes)) %}
        mode = (
            content_capturing_mode
            if content_capturing_mode is not None
            else self.content_capturing_mode
        )
{% endif %}

        if error is not None:
            if isinstance(error, BaseException):
                error = Error.from_exception(error, self._error_type_resolver)
            self.error_type = error.type
            span.set_status(Status(StatusCode.ERROR, error.message))
            span.set_attribute(ErrorAttr.ERROR_TYPE, error.type)
        elif self.error_type is not None:
            span.set_status(Status(StatusCode.ERROR))
            span.set_attribute(ErrorAttr.ERROR_TYPE, self.error_type)

{% for attribute in op.span.attributes %}
{% if not attribute.sampling_relevant and attribute.key not in params.content_attributes and attribute.key != "error.type" %}
{% if attribute.type == "template[string]" %}
